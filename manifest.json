{
  "manifest_version": 3,
  "name": "Meet Attendance Tracker v1.2 (clean)",
  "version": "1.2.1",
  "description": "Privacy-friendly attendance tracking for Google Meet. No emails or phone numbers are collected.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "background": {
    "service_worker": "service-v12.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "tracker-v12.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Meet Attendance Tracker",
    "default_popup": "popup.html"
  }
}